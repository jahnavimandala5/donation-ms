# FoodLink server configuration
# Copy this file to .env and adjust values as needed.

PORT=4000
# MONGODB_URI=mongodb://127.0.0.1:27017/foodlink

# Signs the login tokens. Strongly recommended in production: without it a
# fresh random secret is generated on every boot, so every account is signed
# out each time the service restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Set to 1 to make a missing AUTH_SECRET fatal in production instead of a
# warning. Off by default so a forgotten variable cannot take the site down.
# REQUIRE_AUTH_SECRET=1

# Comma-separated list of allowed browser origins. Leave unset in local
# development to permit any origin.
# CORS_ORIGINS=https://your-frontend.example.com
