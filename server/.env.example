# FoodLink server configuration
# Copy this file to .env and adjust values as needed.

PORT=4000
# MONGODB_URI=mongodb://127.0.0.1:27017/foodlink

# Signs the login tokens. REQUIRED when NODE_ENV=production - the server
# refuses to start without it, because a generated-per-boot secret would log
# every user out on each deploy. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Comma-separated list of allowed browser origins. Leave unset in local
# development to permit any origin.
# CORS_ORIGINS=https://your-frontend.example.com
